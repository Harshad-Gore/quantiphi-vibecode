# Ticketmaster — get a free key at https://developer.ticketmaster.com/
# Dashboard label -> env mapping:
#   "Consumer Key"    -> TICKETMASTER_API_KEY (this is the Discovery API key, REQUIRED for live feed)
#   "Consumer Secret" -> NOT needed (only for OAuth apps; the event feed ignores it)
TICKETMASTER_API_KEY=paste_consumer_key_here
# ...or use the dashboard's exact name instead; both work:
# TICKETMASTER_CONSUMER_KEY=paste_consumer_key_here
TICKETMASTER_COUNTRY=IN
# MongoDB Atlas or local. If empty, app runs in mock in-memory mode.
MONGODB_URI=mongodb://127.0.0.1:27017/vibecheck
PORT=8080
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
