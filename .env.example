# Copy the relevant block into backend/.env and frontend/.env
# --- backend/.env ---
# TICKETMASTER_API_KEY=your_key_here   # optional; mock catalogue used when empty
# TICKETMASTER_COUNTRY=IN
# MONGODB_URI=mongodb://127.0.0.1:27017/vibecheck   # optional; in-memory mode when empty
# PORT=8080
# CORS_ORIGIN=http://localhost:5173
# PUBLIC_BASE_URL=http://localhost:5173
# --- frontend/.env ---
# VITE_API_URL=http://localhost:8080
