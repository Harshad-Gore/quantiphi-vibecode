# Copy the relevant block into backend/.env and frontend/.env
# --- backend/.env ---
# TICKETMASTER_API_KEY=paste_consumer_key_here   # Ticketmaster dashboard "Consumer Key". "Consumer Secret" NOT needed.
#   (Mock catalogue is used when empty, so the app runs without it.)
# TICKETMASTER_COUNTRY=IN
# MONGODB_URI=mongodb://127.0.0.1:27017/vibecheck   # optional; in-memory mode when empty
# PORT=8080
# CORS_ORIGIN=http://localhost:5173
# PUBLIC_BASE_URL=http://localhost:5173
# --- frontend/.env ---
# VITE_API_URL=http://localhost:8080
